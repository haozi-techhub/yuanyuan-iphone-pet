PRODUCT_NAME = DesktopPet
PRODUCT_BUNDLE_IDENTIFIER = com.haozi.desktoppet
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 5
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Automatic
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = DesktopPet/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = 圆圆
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_NSCameraUsageDescription = 圆圆用前置摄像头感知你的位置并识别手势。画面只在设备上处理。
INFOPLIST_KEY_NSMicrophoneUsageDescription = 圆圆用麦克风接收语音和感知拍手。开启喊名字唤醒后，圆圆也会在主画面听你喊名字。配置豆包语音后，主动录音将发送至火山引擎进行转写。
INFOPLIST_KEY_NSMotionUsageDescription = 圆圆用运动传感器感知手机的倾斜、翻转和摇晃。
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = 圆圆在设备上识别语音和唤醒词。启用 DeepSeek 后，自由聊天的转写文字会发给 DeepSeek。
